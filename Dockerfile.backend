FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy dependency declarations first for layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies into the system Python (no .venv in containers)
RUN uv sync --frozen --no-dev --no-install-project

# Copy source
COPY code/ code/
COPY VERSION ./

WORKDIR /app

ENV PYTHONPATH=/app/code/backend
ENV PYTHONUNBUFFERED=1

# curl is used by docker-compose's healthcheck; git is required by GitPython
# (md_editor.py's commit flow); tzdata makes the TZ=Asia/Kolkata env var
# (set in docker-compose.yml, for the IST-wall-clock cron schedule) actually
# resolve — python:3.12-slim ships none of the three. openssh-client is for
# offsite.py: it pushes the corpus over SSH with a deploy key, and git shells
# out to the `ssh` binary to do it — without this the nightly offsite_push
# dies with "ssh: command not found" the moment a remote exists.
RUN apt-get update && apt-get install -y --no-install-recommends curl git openssh-client tzdata \
    && rm -rf /var/lib/apt/lists/*

# GeoIP database for admin login monitoring (geoip_lookup.py) — DB-IP City
# Lite, CC-BY 4.0. Downloaded here rather than committed to git: ~127MB
# uncompressed. Dated monthly URL — tries the current month, falls back to
# last month, and gives up silently if both 404 (geoip_lookup.py degrades
# gracefully to "unknown location" with no missing file, never a build or
# boot failure). Bump/refresh by rebuilding the image periodically.
RUN mkdir -p /app/geoip && \
    MONTH=$(date -u +%Y-%m) && \
    PREV_MONTH=$(date -u -d "$(date -u +%Y-%m-01) -1 month" +%Y-%m) && \
    (curl -fsSL "https://download.db-ip.com/free/dbip-city-lite-${MONTH}.mmdb.gz" -o /tmp/geoip.mmdb.gz \
      || curl -fsSL "https://download.db-ip.com/free/dbip-city-lite-${PREV_MONTH}.mmdb.gz" -o /tmp/geoip.mmdb.gz \
      || true) && \
    if [ -f /tmp/geoip.mmdb.gz ]; then \
      gunzip -c /tmp/geoip.mmdb.gz > /app/geoip/dbip-city-lite.mmdb; \
      rm -f /tmp/geoip.mmdb.gz; \
    fi

# Run as a non-root user — no reason gunicorn/the worker need root inside the container.
# uid/gid pinned to 1000 to match the host user that owns the bind-mounted
# ./data directory (the MD corpus + SQLite DB) — a mismatched uid can read
# those files but not write to them ("attempt to write a readonly database").
RUN groupadd -r -g 1000 sleepy && useradd -r -u 1000 -g sleepy -d /app sleepy \
    && chown -R sleepy:sleepy /app
USER sleepy

EXPOSE 5000

# Single process (RAM is tight on a t3.micro), but gthread + a few threads
# instead of the plain sync worker class — otherwise the one process is
# fully blocked for the entire duration of any /api/ai/chat SSE stream,
# unable to serve so much as /healthz until it finishes.
CMD ["uv", "run", "gunicorn", \
     "--bind", "0.0.0.0:5000", \
     "--workers", "1", \
     "--worker-class", "gthread", \
     "--threads", "4", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "app:app"]
