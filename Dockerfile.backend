FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy dependency declarations first for layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies into the system Python (no .venv in containers)
RUN uv sync --frozen --no-dev --no-install-project

# Copy source
COPY code/ code/
COPY VERSION ./

WORKDIR /app

ENV PYTHONPATH=/app/code/backend
ENV PYTHONUNBUFFERED=1

# curl is used by docker-compose's healthcheck; python:3.12-slim doesn't ship it.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Run as a non-root user — no reason gunicorn/the worker need root inside the container.
RUN groupadd -r sleepy && useradd -r -g sleepy -d /app sleepy \
    && chown -R sleepy:sleepy /app
USER sleepy

EXPOSE 5000

# Single worker — single-user personal app, no request concurrency needed,
# and every worker process costs RAM on a memory-constrained host.
CMD ["uv", "run", "gunicorn", \
     "--bind", "0.0.0.0:5000", \
     "--workers", "1", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "code/backend/app:app"]
